# =============================================================================
# Quiz App — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------

# A long, random, secret string used for cryptographic signing.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Set to 1 only for local development. Must be 0 in production.
DEBUG=0

# Comma-separated list of hostnames/IPs Django will accept requests for.
# Example: localhost,127.0.0.1,myapp.example.com,10.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# -----------------------------------------------------------------------------

POSTGRES_DB=quiz_db
POSTGRES_USER=quiz_user

# Choose a strong password for the database user.
POSTGRES_PASSWORD=change-me

# Built automatically from the variables above — no need to edit this line.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Production Docker Postgres uses SSL certs from the cert-gen service (default True).
# Set False only for local/CI Postgres containers that have no certificates.
# DB_SSL_REQUIRE=True

# -----------------------------------------------------------------------------
# Celery / Redis Settings
# -----------------------------------------------------------------------------

# Redis is used as the Celery message broker and result backend.
# The default values below work with the docker-compose redis service.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# AI Grading — choose one provider
# -----------------------------------------------------------------------------

# Which LLM gateway to use: "gemini" (default) or "vertex"
LLM_PROVIDER=gemini

# --- Option A: Gemini direct API key ---
# Required when LLM_PROVIDER=gemini.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Option B: Google Vertex AI via service account ---
# Required when LLM_PROVIDER=vertex.
# Place your service-account JSON key at secrets/vertex-sa-key.json (never commit it).
# See docs/GRADING.md for full setup instructions.
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.5-flash
