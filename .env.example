# =============================================================================
# Quiz App — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------

# A long, random, secret string used for cryptographic signing.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Set to 1 only for local development. Must be 0 in production.
DEBUG=0

# Comma-separated list of hostnames/IPs Django will accept requests for.
# Example: localhost,127.0.0.1,myapp.example.com,10.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# -----------------------------------------------------------------------------

POSTGRES_DB=quiz_db
POSTGRES_USER=quiz_user

# Choose a strong password for the database user.
POSTGRES_PASSWORD=change-me

# Built automatically from the variables above — no need to edit this line.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Celery / Redis Settings
# -----------------------------------------------------------------------------

# Redis is used as the Celery message broker and result backend.
# The default values below work with the docker-compose redis service.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# AI Grading (Google Gemini)
# -----------------------------------------------------------------------------

# Required for AI grading of open-ended questions.
# Obtain a key at: https://aistudio.google.com/app/apikey
# Leave empty to disable AI grading (open-ended questions will not be graded).
GEMINI_API_KEY=your-gemini-api-key-here
